# Production Caddyfile for Field Worker Tracker (FWT)
# Enforces TLS 1.3, HSTS, secure headers, CSP, and compression per docs/14-nonfunctional.md

{$DOMAIN:fieldtracker.example.com} {
    # Automatic TLS via Let's Encrypt / ZeroSSL
    tls {$ACME_EMAIL:admin@example.com}

    # Security Headers
    header {
        # HTTP Strict Transport Security (HSTS) - 1 year with subdomains and preload
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        # Clickjacking protection
        X-Frame-Options "DENY"
        # MIME-type sniffing protection
        X-Content-Type-Options "nosniff"
        # Referrer Policy
        Referrer-Policy "strict-origin-when-cross-origin"
        # Content Security Policy
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://api.fieldtracker.example.com wss://api.fieldtracker.example.com; frame-ancestors 'none';"
        # Remove server identity headers
        -Server
    }

    # Gzip and Zstandard compression
    encode zstd gzip

    # Static web dashboard assets
    handle /assets/* {
        root * /srv/web
        file_server
        header Cache-Control "public, max-age=31536000, immutable"
    }

    # API and Mobile endpoints
    handle /api/* {
        reverse_proxy api:8000 {
            header_up X-Forwarded-Proto {scheme}
            header_up X-Real-IP {remote_host}
        }
    }

    # Health check probe
    handle /health/* {
        reverse_proxy api:8000
    }

    # Single Page Application fallback for React router
    handle {
        root * /srv/web
        try_files {path} /index.html
        file_server
    }
}
