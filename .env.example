# Environment
APP_ENV=local
DEPLOYMENT_COUNTRY=AE

# Database (PostgreSQL + PostGIS)
# For application runtime
DATABASE_URL=postgresql+asyncpg://fw_app:fw_secret@localhost:5432/fw_db
# For migrations (DDL permissions)
DATABASE_MIGRATOR_URL=postgresql+asyncpg://fw_migrator:fw_migrator_secret@localhost:5432/fw_db

# Security & Authentication
JWT_SECRET=insecure-dev-secret-key-change-in-production-min-32-bytes
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]


FILE_STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# Maps are configured in the web app only (ADR-033); see web/.env.example and
# docs/runbooks/08-google-maps-keys.md. The backend has no map settings.

# Logging
LOG_LEVEL=INFO

# Speed measuring (Batch 9, docs/runbooks/06): Server-Timing header and a request_timing log line
# per request. Dev and staging only; ignored when APP_ENV=production.
PERF_TIMING_ENABLED=false
PERF_SLOW_QUERY_MS=100

