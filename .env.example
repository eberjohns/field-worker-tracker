# Environment
APP_ENV=local
DEPLOYMENT_COUNTRY=AE

# Database (PostgreSQL + PostGIS)
# For application runtime
DATABASE_URL=postgresql+asyncpg://fw_app:fw_secret@localhost:5432/fw_db
# For migrations (DDL permissions)
DATABASE_MIGRATOR_URL=postgresql+asyncpg://fw_migrator:fw_migrator_secret@localhost:5432/fw_db

# Security & Authentication
JWT_SECRET=insecure-dev-secret-key-change-in-production-min-32-bytes
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# External services adapters
PUSH_BACKEND=null
FCM_CREDENTIALS=""

EMAIL_BACKEND=smtp
SMTP_HOST=localhost
SMTP_PORT=1025

FILE_STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./storage

# Map configuration (web)
MAP_STYLE_STREETS_URL=https://api.maptiler.com/maps/streets-v2/style.json?key={key}
MAP_STYLE_SATELLITE_URL=https://api.maptiler.com/maps/satellite/style.json?key={key}
MAP_API_KEY=dev_placeholder_key

# Logging
LOG_LEVEL=INFO
