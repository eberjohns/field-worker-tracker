{
  "name": "field-worker-tracker-web",
  "private": true,
  "version": "1.27.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "tsc --noEmit && node scripts/check-ui-rules.mjs",
    "check:ui": "node scripts/check-ui-rules.mjs",
    "test": "node --import ./scripts/register-ts.mjs --test \"src/**/*.test.ts\" \"src/**/*.test.tsx\" \"scripts/*.test.mjs\"",
    "codegen:api": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "2.1.3",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.88.0",
    "@tanstack/react-table": "^8.20.5",
    "@turf/area": "^7.4.0",
    "@turf/boolean-valid": "^7.4.0",
    "@turf/centroid": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/kinks": "^7.4.0",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.5.5",
    "terra-draw": "^1.39.0",
    "terra-draw-google-maps-adapter": "1.7.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/google.maps": "3.67.0",
    "@types/node": "^22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "openapi-typescript": "^7.4.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
