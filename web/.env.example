# Web app settings (Vite). Copy to web/.env.local (git-ignored) and fill in locally;
# on the hosting, set them in its environment settings. Never commit real values.
# Map provider and keys: docs/runbooks/08-google-maps-keys.md (ADR-033).

# google | maplibre (default maplibre). google needs both Google values below;
# without them the app uses the MapLibre fallback.
VITE_MAP_PROVIDER=maplibre

# Google Maps Platform: web key restricted to the app's domains and to
# Maps JavaScript API + Places API (New); Map ID of a JavaScript vector map.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# MapLibre fallback: MapTiler key for streets/satellite tiles and search.
# Empty = OpenStreetMap tiles and Nominatim search.
VITE_MAP_API_KEY=
